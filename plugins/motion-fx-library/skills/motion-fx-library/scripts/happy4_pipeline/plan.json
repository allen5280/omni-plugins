"lines": [
{
"s": 0.0,
"e": 1.76,
"text": "快樂不用等好事發生",
"hl": "快樂",
"src": 0.8
},
{
"s": 1.8,
"e": 2.94,
"text": "其實是你能控制的",
"hl": null,
"src": 2.6
},
{
"s": 2.96,
"e": 3.72,
"text": "化學反應",
"hl": "化學反應",
"src": 3.76
},
{
"s": 3.76,
"e": 5.04,
"text": "大腦用四種物質",
"hl": "四種物質",
"src": 4.56
},
{
"s": 5.06,
"e": 6.56,
"text": "決定你今天過得爽不爽",
"hl": "爽不爽",
"src": 5.86
},
{
"s": 6.66,
"e": 7.92,
"text": "每一種都有開關",
"hl": "開關",
"src": 7.46
},
{
"s": 8.0,
"e": 9.0,
"text": "第一，多巴胺",
"hl": "多巴胺",
"src": 8.8
},
{
"s": 9.06,
"e": 10.42,
"text": "是期待和得到的快樂",
"hl": "期待",
"src": 9.88
},
{
"s": 10.5,
"e": 11.46,
"text": "科學家舒茲",
"hl": "舒茲",
"src": 11.32
},
{
"s": 11.48,
"e": 12.4,
"text": "拿猴子做實驗",
"hl": "猴子",
"src": 12.3
},
{
"s": 12.46,
"e": 13.62,
"text": "燈一亮，果汁還沒到",
"hl": "還沒到",
"src": 13.28
},
{
"s": 13.64,
"e": 14.72,
"text": "多巴胺就先衝了",
"hl": "先衝了",
"src": 14.46
},
{
"s": 14.78,
"e": 15.96,
"text": "所以你期待包裹",
"hl": "期待",
"src": 15.6
},
{
"s": 15.98,
"e": 16.46,
"text": "快來的時候",
"hl": null,
"src": 16.8
},
{
"s": 16.48,
"e": 17.8,
"text": "比拆包裹還開心",
"hl": "還開心",
"src": 17.3
},
{
"s": 17.96,
"e": 18.94,
"text": "不用下單燒錢",
"hl": "燒錢",
"src": 18.78
},
{
"s": 19.04,
"e": 20.7,
"text": "洗澡最後 30 秒轉冷水",
"hl": "轉冷水",
"src": 19.86
},
{
"s": 20.82,
"e": 21.78,
"text": "捷克的研究",
"hl": null,
"src": 21.64
},
{
"s": 21.8,
"e": 22.6,
"text": "14 度冷水",
"hl": "14 度",
"src": 22.62
},
{
"s": 22.62,
"e": 24.08,
"text": "多巴胺多了兩倍半",
"hl": "兩倍半",
"src": 23.44
},
{
"s": 24.54,
"e": 25.32,
"text": "第二，血清素",
"hl": "血清素",
"src": 26.12
},
{
"s": 25.34,
"e": 26.58,
"text": "穩健踏實的快樂",
"hl": "穩健踏實",
"src": 26.92
},
{
"s": 26.86,
"e": 27.47,
"text": "彼得森在",
"hl": null,
"src": 28.45
},
{
"s": 27.49,
"e": 28.86,
"text": "《生存的十二條法則》說",
"hl": "生存的十二條法則",
"src": 29.08
},
{
"s": 29.19,
"e": 30.3,
"text": "龍蝦幹架贏了之後",
"hl": "贏了",
"src": 30.85
},
{
"s": 30.32,
"e": 31.34,
"text": "血清素就升高",
"hl": "升高",
"src": 31.98
},
{
"s": 31.36,
"e": 32.04,
"text": "站得更挺",
"hl": "更挺",
"src": 33.02
},
{
"s": 32.34,
"e": 33.34,
"text": "你不用跟別人輸贏",
"hl": "輸贏",
"src": 33.98
},
{
"s": 33.36,
"e": 34.4,
"text": "曬太陽就有了",
"hl": "曬太陽",
"src": 35.0
},
{
"s": 34.72,
"e": 36.03,
"text": "國際頂尖醫學期刊",
"hl": null,
"src": 36.74
},
{
"s": 36.24,
"e": 36.96,
"text": "《刺胳針》的研究",
"hl": "刺胳針",
"src": 38.33
},
{
"s": 37.22,
"e": 37.91,
"text": "日照越長",
"hl": "日照越長",
"src": 41.73
},
{
"s": 37.93,
"e": 39.13,
"text": "大腦製造的血清素",
"hl": null,
"src": 42.44
},
{
"s": 39.15,
"e": 39.79,
"text": "就越多",
"hl": "越多",
"src": 43.66
},
{
"s": 40.06,
"e": 40.68,
"text": "記得防曬",
"hl": "防曬",
"src": 44.7
},
{
"s": 41.01,
"e": 42.23,
"text": "此外再加上冥想",
"hl": "冥想",
"src": 46.3
},
{
"s": 42.46,
"e": 43.17,
"text": "效益加倍",
"hl": "加倍",
"src": 47.81
},
{
"s": 43.47,
"e": 44.39,
"text": "哈佛團隊發現",
"hl": "哈佛",
"src": 48.82
},
{
"s": 44.65,
"e": 45.34,
"text": "冥想八週",
"hl": "八週",
"src": 63.13
},
{
"s": 45.37,
"e": 46.95,
"text": "大腦焦慮警報密度",
"hl": "焦慮警報",
"src": 63.85
},
{
"s": 46.97,
"e": 47.92,
"text": "大幅下降",
"hl": "下降",
"src": 65.45
},
{
"s": 48.22,
"e": 49.54,
"text": "白天出門散步或慢跑",
"hl": "散步",
"src": 68.73
},
{
"s": 49.58,
"e": 50.59,
"text": "回來閉眼幾分鐘",
"hl": "閉眼",
"src": 70.09
},
{
"s": 50.62,
"e": 51.94,
"text": "這兩件事龍蝦都做不到",
"hl": "龍蝦都做不到",
"src": 71.13
},
{
"s": 52.0,
"e": 52.79,
"text": "你隨時能開始",
"hl": "隨時",
"src": 72.51
},
{
"s": 53.24,
"e": 54.21,
"text": "第三，腦內啡",
"hl": "腦內啡",
"src": 78.98
},
{
"s": 54.23,
"e": 55.17,
"text": "身體內建的",
"hl": null,
"src": 80.0
},
{
"s": 55.19,
"e": 56.39,
"text": "幸福劑和止痛藥",
"hl": "止痛藥",
"src": 80.96
},
{
"s": 56.91,
"e": 57.87,
"text": "德國團隊掃描",
"hl": null,
"src": 82.68
},
{
"s": 57.89,
"e": 58.75,
"text": "跑者的大腦",
"hl": "跑者",
"src": 83.66
},
{
"s": 58.77,
"e": 59.97,
"text": "跑步後真的在釋放",
"hl": "釋放",
"src": 84.54
},
{
"s": 59.99,
"e": 60.95,
"text": "還有牛津的實驗",
"hl": "牛津",
"src": 85.76
},
{
"s": 60.97,
"e": 61.93,
"text": "一群人大笑完",
"hl": "大笑",
"src": 86.74
},
{
"s": 61.95,
"e": 62.79,
"text": "比較不怕痛",
"hl": "不怕痛",
"src": 87.72
},
{
"s": 63.18,
"e": 63.89,
"text": "適度吃辣也可以",
"hl": "吃辣",
"src": 88.95
},
{
"s": 64.43,
"e": 65.13,
"text": "心理學家羅津",
"hl": "羅津",
"src": 90.2
},
{
"s": 65.15,
"e": 66.47,
"text": "叫它良性自虐",
"hl": "良性自虐",
"src": 90.92
},
{
"s": 66.81,
"e": 67.85,
"text": "所以保持運動習慣",
"hl": "運動",
"src": 95.62
},
{
"s": 67.87,
"e": 69.13,
"text": "或是找朋友開心大笑",
"hl": "大笑",
"src": 96.68
},
{
"s": 69.15,
"e": 69.99,
"text": "一起吃麻辣鍋",
"hl": "麻辣鍋",
"src": 97.96
},
{
"s": 70.21,
"e": 70.91,
"text": "都會讓你馬上",
"hl": null,
"src": 100.28
},
{
"s": 70.93,
"e": 71.88,
"text": "感到幸福快樂",
"hl": "幸福快樂",
"src": 101.0
},
{
"s": 72.22,
"e": 73.32,
"text": "第四，催產素",
"hl": "催產素",
"src": 102.26
},
{
"s": 73.34,
"e": 74.64,
"text": "讓你滿滿的安全感",
"hl": "安全感",
"src": 103.38
},
{
"s": 74.88,
"e": 76.11,
"text": "Science 期刊研究",
"hl": "Science",
"src": 104.99
},
{
"s": 76.19,
"e": 77.87,
"text": "跟自己的小貓小狗對看",
"hl": "對看",
"src": 106.3
},
{
"s": 77.93,
"e": 79.11,
"text": "催產素一起上升",
"hl": "上升",
"src": 108.04
},
{
"s": 79.43,
"e": 80.17,
"text": "家族治療大師",
"hl": null,
"src": 109.84
},
{
"s": 80.19,
"e": 80.91,
"text": "薩提爾說過",
"hl": "薩提爾",
"src": 110.6
},
{
"s": 80.93,
"e": 82.31,
"text": "人一天四個擁抱",
"hl": "四個擁抱",
"src": 111.34
},
{
"s": 82.37,
"e": 82.95,
"text": "活得更好",
"hl": "更好",
"src": 112.78
},
{
"s": 83.52,
"e": 84.27,
"text": "我爸離開以後",
"hl": null,
"src": 123.85
},
{
"s": 84.31,
"e": 85.07,
"text": "讓我更珍惜",
"hl": "珍惜",
"src": 124.64
},
{
"s": 85.13,
"e": 86.52,
"text": "時常都會抱一下我媽",
"hl": "抱一下我媽",
"src": 125.46
},
{
"s": 87.06,
"e": 88.32,
"text": "這四個開關都不用錢",
"hl": "不用錢",
"src": 127.44
},
{
"s": 88.34,
"e": 89.52,
"text": "轉發給你在乎的人",
"hl": "在乎的人",
"src": 128.72
},
{
"s": 89.54,
"e": 91.12,
"text": "把幸福快樂傳出去",
"hl": "傳出去",
"src": 129.92
}
],
